{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.rulers": [120],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Markdown specific
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },

  // YAML specific
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced"
  },

  // JSON specific
  "[json]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },

  // Go specific
  "[go]": {
    "editor.insertSpaces": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // File associations
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml",
    "*.md": "markdown"
  },

  // Exclude files from explorer
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/_site": true,
    "**/public": true,
    "**/.hugo_build.lock": true
  },

  // Search exclude
  "search.exclude": {
    "**/node_modules": true,
    "**/public": true,
    "**/_site": true,
    "**/resources": true,
    "**/.hugo_build.lock": true,
    "**/go.sum": true
  },

  // Markdown lint configuration
  "markdownlint.config": {
    "extends": ".markdownlint.json"
  },

  // Spell checker
  "cSpell.words": [
    "OWASP",
    "owaspai",
    "Hextra",
    "Hugo",
    "Firebase",
    "Dependabot",
    "CodeQL",
    "TruffleHog",
    "govulncheck",
    "markdownlint",
    "lychee",
    "peaceiris",
    "imfing"
  ],

  // Hugo specific
  "hugo.server.renderStaticToDisk": false,

  // Git
  "git.ignoreLimitWarning": true,

  // Enable breadcrumbs
  "breadcrumbs.enabled": true,

  // Terminal
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
